PORT=3000
#DB_ADDRESS=mongodb://root:example@mongo:27017/weblarek?authSource=admin - использовть эту переменную окружения, если запускаем в Docker
DB_ADDRESS=mongodb://127.0.0.1:27017/weblarek?authSource=admin
UPLOAD_PATH=images
UPLOAD_PATH_TEMP=temp
ORIGIN_ALLOW=http://localhost:5173
AUTH_REFRESH_TOKEN_EXPIRY=7d
AUTH_ACCESS_TOKEN_EXPIRY=10m

# Обязательные уникальные секреты для production (создать через openssl rand -hex 32)
AUTH_ACCESS_TOKEN_SECRET=replace-with-random-64-hex-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-random-64-hex-characters
COOKIE_SECURE=false
NODE_ENV=development
